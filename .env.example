# Backend Host & Port
HOST=127.0.0.1
PORT=8000

# SQLite Database Location
DATABASE_PATH=cyclecare.db

# Ollama Local Configuration
# Ollama runs on port 11434 by default
OLLAMA_HOST=http://localhost:11434

# Recommended open-source model (e.g. gemma2:2b, gemma:2b, llama3.2, mistral)
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT=60.0
